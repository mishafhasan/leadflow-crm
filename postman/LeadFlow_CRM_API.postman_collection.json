					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": ["{{base_url}}"],
					"path": ["api", "auth", "login"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Login is successful', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.success).to.be.true;",
							"});",
							"",
							"pm.test('Token is returned', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string').and.not.empty;",
							"});",
							"",
							"pm.test('User object is returned', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.user).to.be.an('object');",
							"    pm.expect(json.user.id).to.be.a('string');",
							"    pm.expect(json.user.name).to.be.a('string');",
							"    pm.expect(json.user.email).to.be.a('string');",
							"    pm.expect(json.user.role).to.be.a('string');",
							"});",
							"",
							"// ── AUTO-SAVE: Store token for all subsequent requests ──",
							"const json = pm.response.json();",
							"if (json.success && json.token) {",
							"    pm.environment.set('token', json.token);",
							"    console.log('✅ Token saved to environment');",
							"}"
						]
					}
				}
			]
		},
